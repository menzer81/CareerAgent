# OpenAI-compatible LLM configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Database
DATABASE_URL=sqlite+aiosqlite:///./career_agent.db

# Application
DEBUG=false
LOG_LEVEL=INFO
APP_TITLE=CareerAgent
APP_VERSION=0.1.0

# Report output directory (relative to cwd)
REPORTS_DIR=./reports
