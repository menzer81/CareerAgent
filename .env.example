# OpenAI-only LLM configuration
# Put your OpenAI API key here.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini-2025-08-07

# Optional multi-provider routing
# Modes: single | local_first | cloud_first
LLM_ROUTING_MODE=local_first

# Local model provider (Ollama/LM Studio/OpenAI-compatible local server)
# Leave these blank unless you want to use a local model.
# Defaults are set for local qwen3:14b via Ollama.
LOCAL_OPENAI_API_KEY=ollama
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_MODEL=qwen3:14b

# Cloud fallback provider (OpenAI/Azure/OpenRouter compatible)
# Leave these blank unless you want a second provider.
CLOUD_OPENAI_API_KEY=
CLOUD_OPENAI_BASE_URL=https://api.openai.com/v1
CLOUD_OPENAI_MODEL=gpt-5-mini-2025-08-07

# LLM timeout controls (seconds)
# Increase these if local models or large prompts need more time before fallback.
LLM_EXTRACT_TIMEOUT_SECONDS=45
LLM_SCORING_TIMEOUT_SECONDS=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./career_agent.db

# Application
DEBUG=false
LOG_LEVEL=INFO
APP_TITLE=CareerAgent
APP_VERSION=0.1.0

# Report output directory (relative to cwd)
REPORTS_DIR=./reports
